# Copiar a .env y ajustar. El fichero .env no se versiona.

# Base de datos
POSTGRES_USER=quickshop
POSTGRES_PASSWORD=cambiar_esta_password
POSTGRES_DB=quickshop

# Backend
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
BACKEND_PORT=8000

# Seed inicial (admin y clientes)
SEED_ADMIN_EMAIL=admin@quickshop.com
SEED_ADMIN_PASSWORD=Admin1234!
SEED_CUSTOMER_PASSWORD=Cliente1234!

# Frontend (VITE_API_URL vacio: el navegador usa rutas relativas /api, que nginx reenvia al backend; solo rellenar si la API esta en otro origen)
VITE_API_URL=
FRONTEND_PORT=5173
